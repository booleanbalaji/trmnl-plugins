{% assign wx = locality_weather_data %}
{% assign temp = wx.temperature %}
{% assign humidity = wx.humidity %}
{% assign rain_a = wx.rain_accumulation %}
{% if wx.rain_intensity and wx.rain_intensity > 0 %}
  {% assign conditions = "Rain" %}
{% else %}
  {% assign conditions = "Clear" %}
{% endif %}

<div class="layout layout--col gap--space-between">
  <div class="item">
    <div class="content">
      {% if temp %}
        <span class="value value--large" data-fit-value="true">{{ temp | round: 1 }}°</span>
        <span class="label">{{ conditions }}</span>
      {% else %}
        <span class="value value--small">{{ conditions }}</span>
        <span class="label">Weather Union</span>
      {% endif %}
    </div>
  </div>
  <div class="item">
    <div class="content">
      <span class="label">{% if humidity %}{{ humidity | round }}% RH{% else %}—{% endif %}</span>
      <span class="label">{% if rain_a %}{{ rain_a }} mm today{% else %}—{% endif %}</span>
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/weather--render.svg" alt="">
  <span class="title">Weather Union</span>
  <span class="instance">{{ trmnl.plugin_settings.custom_fields_values.location_label | default: "India" }}</span>
</div>
