<div class="view view--quadrant">
  <% if error.present? %>
    <div class="layout layout--col">
      <span class="value value--xsmall weather-union-error"><%= error %></span>
    </div>
  <% else %>
    <div class="layout">
      <div class="grid grid--cols-2">
        <div class="row row--center">
          <img class="weather-union-image" src="<%= Rails.application.credentials.base_url %>/images/weather/<%= weather_image %>.svg" />
        </div>

        <div class="col gap--space-between">
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <% if temperature.present? %>
                <span class="value value--large" data-fit-value="true"><%= temperature %>°</span>
                <span class="label"><%= conditions %></span>
              <% else %>
                <span class="value value--small" data-fit-value="true"><%= conditions %></span>
                <span class="label"><%= device_type_label %></span>
              <% end %>
            </div>
          </div>
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="label"><%= humidity.nil? ? '—' : "#{humidity}% RH" %></span>
              <span class="label"><%= rain_accumulation.nil? ? '—' : "#{rain_accumulation} mm today" %></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%= render 'plugins/weather_union/shared/title_bar', location_label: location_label, refreshed_at: refreshed_at %>
</div>

<%= render 'plugins/weather_union/common' %>
