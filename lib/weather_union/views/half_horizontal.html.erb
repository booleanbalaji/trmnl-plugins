<div class="view view--half_horizontal">
  <% if error.present? %>
    <div class="layout layout--col">
      <span class="value value--xsmall weather-union-error"><%= error %></span>
    </div>
  <% else %>
    <div class="layout">
      <div class="grid">
        <div class="col col--span-1 col--center">
          <div class="row row--center">
            <img class="weather-union-image" src="<%= Rails.application.credentials.base_url %>/images/weather/<%= weather_image %>.svg" />
          </div>
        </div>
        <div class="col col--span-2 col--center">
          <div class="grid grid--cols-2">
            <div class="item">
              <div class="meta"></div>
              <div class="content">
                <% if temperature.present? %>
                  <span class="value value--xlarge" data-fit-value="true"><%= temperature %>°</span>
                  <span class="label"><%= conditions %></span>
                <% else %>
                  <span class="value value--large" data-fit-value="true"><%= conditions %></span>
                  <span class="label"><%= device_type_label %></span>
                <% end %>
              </div>
            </div>
            <div class="item">
              <div class="meta"></div>
              <div class="content">
                <% if humidity.present? %>
                  <span class="value value"><%= humidity %>%</span>
                  <span class="label">Humidity</span>
                <% elsif rain_accumulation.present? %>
                  <span class="value value"><%= rain_accumulation %> mm</span>
                  <span class="label">Rain today</span>
                <% else %>
                  <span class="value value--xsmall"><%= wind_cardinal || '—' %></span>
                  <span class="label">Wind</span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%= render 'plugins/weather_union/shared/title_bar', location_label: location_label, refreshed_at: refreshed_at %>
</div>

<%= render 'plugins/weather_union/common' %>
